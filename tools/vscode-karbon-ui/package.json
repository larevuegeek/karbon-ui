{
  "name": "karbon-ui-language",
  "displayName": "Karbon UI",
  "description": "Syntax highlighting, indentation and snippets for karbon-ui .ui templates (HTML-like markup with Rust expressions).",
  "version": "0.2.0",
  "publisher": "LaRevueGeek",
  "license": "(MIT OR Apache-2.0)",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f1626",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/larevuegeek/karbon-ui",
    "directory": "tools/vscode-karbon-ui"
  },
  "homepage": "https://github.com/larevuegeek/karbon-ui/tree/main/tools/vscode-karbon-ui",
  "bugs": {
    "url": "https://github.com/larevuegeek/karbon-ui/issues"
  },
  "keywords": [
    "karbon",
    "karbon-ui",
    "rust",
    "ui",
    "template",
    "html",
    "desktop"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "karbon-ui",
        "aliases": [
          "Karbon UI",
          "karbon-ui"
        ],
        "extensions": [
          ".ui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "karbon-ui",
        "scopeName": "text.karbon-ui",
        "path": "./syntaxes/karbon-ui.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.rust": "rust"
        }
      }
    ],
    "snippets": [
      {
        "language": "karbon-ui",
        "path": "./snippets/karbon-ui.json"
      }
    ]
  }
}
