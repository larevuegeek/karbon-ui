<Row gap="lg" stretch full style="height: 560px">
    <Stack gap="sm" style="width: 300px">
        <Input search icon="search" placeholder="Rechercher" />
        <List>
            {#each CONVERSATIONS.iter().enumerate() as item (item.0)}
                <ListItem title={item.1.0} subtitle={item.1.1} active={item.0 == self.conversation} onclick={Msg::Conversation(item.0)}>
                    <Avatar slot="leading" name={item.1.0} />
                    <Stack slot="trailing" gap="xs" end>
                        <Text sm muted>{item.1.2}</Text>
                        {#if item.1.3 > 0 && item.0 != self.conversation}<Badge primary solid>{item.1.3}</Badge>{/if}
                    </Stack>
                </ListItem>
            {/each}
        </List>
    </Stack>
    <Card gap="none" padding="none" style="flex-grow: 1; flex-basis: 0">
        <Row gap="md" full style="padding: 16px 20px">
            <User name={CONVERSATIONS[self.conversation].0} description="En ligne" />
            <Spacer />
            <IconButton icon="more-horizontal" label="Options" pill />
        </Row>
        <Divider />
        <Stack gap="sm" grow padding="lg" style="overflow-y: auto; scrollbar-width: thin">
            <div class="bubble"><Text>{CONVERSATIONS[self.conversation].1}</Text></div>
            {#each self.messages[self.conversation].iter().enumerate() as message (message.0)}
                <Row main_end full><div class="bubble bubble-me"><Text>{message.1}</Text></div></Row>
            {/each}
        </Stack>
        <Row gap="sm" full style="padding: 12px 16px">
            <Stack grow>
                <Input placeholder="Écrire un message" value={&self.draft} oninput={Msg::Draft} onenter={Msg::Send}>
                    <IconButton slot="end" sm pill solid primary icon="arrow-right" label="Envoyer" onclick={Msg::Send} />
                </Input>
            </Stack>
        </Row>
    </Card>
</Row>
