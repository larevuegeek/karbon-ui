<Grid min={380.} gap="2xl" style="padding: 40px 8px 24px">
    <Stack gap="lg" main_center>
        <Badge primary dot>Natif, sans navigateur</Badge>
        <Stack gap="none">
            <Title display>Des interfaces</Title>
            <Title display gradient>magnifiques,</Title>
            <Title display>sans effort.</Title>
        </Stack>
        <Text lg muted>Des composants soignés, un thème clair et sombre, et une syntaxe que vous lisez comme du HTML.</Text>
        <Row gap="md" wrap>
            <Button primary shadow pill lg icon_right="arrow-right" onclick={Msg::Section(1)}>Voir les exemples</Button>
            <Button faded pill lg onclick={Msg::Section(EVENTS_SECTION)}>Voir les événements</Button>
        </Row>
    </Stack>
    <Stack gap="lg">
        <Card padding="lg" gap="md">
            <Row gap="md">
                <Avatar name="Ada Lovelace" />
                <Stack gap="none" grow>
                    <Text bold>Ada Lovelace</Text>
                    <Text sm muted>@ada</Text>
                </Stack>
                <Button primary sm pill onclick={Msg::Follow}>{if self.follow { "Suivi" } else { "Suivre" }}</Button>
            </Row>
            <Text muted>Première programmeuse, mélomane à ses heures.</Text>
            <Row gap="lg">
                <Text sm><b>4</b> abonnements</Text>
                <Text sm><b>97,1 k</b> abonnés</Text>
            </Row>
        </Card>
        <Card padding="lg" gap="md">
            <Row gap="lg">
                <div class="cover"><Icon name="music" size={30} /></div>
                <Stack gap="xs" grow>
                    <Row between full>
                        <Stack gap="none">
                            <Text bold>Blue Train</Text>
                            <Text sm muted>John Coltrane</Text>
                        </Stack>
                        <IconButton icon="heart" label="Aimer" sm pill />
                    </Row>
                    <Progress value={42} />
                    <Row between full>
                        <Text sm muted>4:32</Text>
                        <Text sm muted>10:43</Text>
                    </Row>
                    <Row main_center gap="sm" full>
                        <IconButton icon="chevron-left" label="Précédent" pill />
                        <IconButton icon="play" label="Lecture" lg pill solid primary />
                        <IconButton icon="chevron-right" label="Suivant" pill />
                    </Row>
                </Stack>
            </Row>
        </Card>
        <Row gap="md" wrap>
            <Tabs items={["Photos", "Musique", "Vidéos"]} value={self.tab} onchange={Msg::Tab} />
            <Switch label="Notifications" checked={self.notify} onchange={Msg::Notify} />
        </Row>
    </Stack>
</Grid>
<Stack gap="sm">
    <Title h3>Des écrans complets, prêts à copier</Title>
    <Grid min={220.} gap="md">
        {#each SECTIONS.iter().enumerate().skip(1).take(FIRST_COMPONENT - 1) as item (item.0)}
            <Card padding="md" gap="xs" hover title="" onclick={Msg::Section(item.0)}>
                <div class="mini" style:background={cover(item.0)}><Icon name={item.1.1} size={20} /></div>
                <Text bold>{item.1.0}</Text>
                <Text sm muted>{item.1.2}</Text>
            </Card>
        {/each}
        <Card padding="md" gap="xs" hover title="" onclick={Msg::Section(FIRST_COMPONENT)}>
            <div class="mini" style:background={cover(7)}><Icon name="plus" size={20} /></div>
            <Text bold>Tous les composants</Text>
            <Text sm muted>Boutons, formulaires, données et plus.</Text>
        </Card>
    </Grid>
</Stack>
