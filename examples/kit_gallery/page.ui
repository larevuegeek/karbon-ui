<Page fixed>
    <Aurora full flat>
        <Navbar>
            <div slot="logo" class="nav-brand">
                <svg src="../../docs/logo/logo-mono.svg" class="nav-logo" aria-label="" />
                <svg src="../../docs/logo/logo-word.svg" aria-label="Karbon UI" />
            </div>
            <Row slot="actions" gap="sm">
                <Select style="width: 110px" aria-label="Couleur d'accent" value={self.accent} options={["Bleu", "Violet", "Rose", "Vert"]} onchange={Msg::Accent} />
                <IconButton icon={if self.dark { "sun" } else { "moon" }} label="Changer de thème" pill onclick={Msg::Dark(!self.dark)} />
            </Row>
        </Navbar>
        <Row grow clip stretch gap="none">
            <Sidebar responsive>
                <NavItem icon="home" active={self.section == 0} onclick={Msg::Section(0)}>Aperçu</NavItem>
                <NavLabel>Exemples</NavLabel>
                {#each SECTIONS.iter().enumerate().skip(1).take(FIRST_COMPONENT - 1) as item (item.0)}
                    <NavItem icon={item.1.1} active={self.section == item.0} onclick={Msg::Section(item.0)}>{item.1.0}</NavItem>
                {/each}
                <NavLabel>Composants</NavLabel>
                {#each SECTIONS.iter().enumerate().skip(FIRST_COMPONENT) as item (item.0)}
                    <NavItem icon={item.1.1} active={self.section == item.0} onclick={Msg::Section(item.0)}>{item.1.0}</NavItem>
                {/each}
            </Sidebar>
            <Stack grow style="overflow-y: auto; scrollbar-width: thin">
                <Container padding="xl" max={1060.}>
                    <Animate up duration={280.} replay={self.section as u64}>
                        <Stack gap="lg">
                            {#if self.section != 0}
                                <Stack gap="xs">
                                    <Title>{SECTIONS[self.section].0}</Title>
                                    <Text muted>{SECTIONS[self.section].2}</Text>
                                </Stack>
                            {/if}
                            {#if self.section == 0}{@include "landing.ui"}
                            {:else if self.section == 1}{@include "ex_dashboard.ui"}
                            {:else if self.section == 2}{@include "ex_shop.ui"}
                            {:else if self.section == 3}{@include "ex_player.ui"}
                            {:else if self.section == 4}{@include "ex_pricing.ui"}
                            {:else if self.section == 5}{@include "ex_signin.ui"}
                            {:else if self.section == 6}{@include "ex_settings.ui"}
                            {:else if self.section == 7}{@include "ex_chat.ui"}
                            {:else if self.section == 8}{@include "typography.ui"}
                            {:else if self.section == 9}{@include "buttons.ui"}
                            {:else if self.section == 10}{@include "forms.ui"}
                            {:else if self.section == 11}{@include "data.ui"}
                            {:else if self.section == 12}{@include "feedback.ui"}
                            {:else if self.section == 13}{@include "navigation.ui"}
                            {:else if self.section == 14}{@include "pagination.ui"}
                            {:else if self.section == 15}{@include "carousel.ui"}
                            {:else if self.section == 16}{@include "animation.ui"}
                            {:else if self.section == 17}{@include "events.ui"}
                            {:else}{@include "overlays.ui"}
                            {/if}
                        </Stack>
                    </Animate>
                </Container>
            </Stack>
        </Row>
    </Aurora>
    {#if self.dialog}
        <Dialog title="Supprimer ce compte ?" onclose={Msg::Dialog(false)}>
            <Text muted>Cette action est irréversible.</Text>
            <Input label="Tapez SUPPRIMER pour confirmer" />
            <Button slot="footer" ghost onclick={Msg::Dialog(false)}>Annuler</Button>
            <Button slot="footer" danger shadow onclick={Msg::Dialog(false)}>Supprimer</Button>
        </Dialog>
    {/if}
    {#if self.drawer.is_some()}
        <Drawer title="Filtres" right={self.drawer == Some(true)} onclose={Msg::Drawer(None)}>
            <Select label="Genre" value={self.genre} options={["Jazz", "Rock", "Classique"]} onchange={Msg::Genre} />
            <Switch label="Notifications" checked={self.notify} onchange={Msg::Notify} />
            <Text sm muted>Le contenu défile si le tiroir est plus haut que la fenêtre.</Text>
            <Button slot="footer" ghost onclick={Msg::Drawer(None)}>Annuler</Button>
            <Button slot="footer" primary onclick={Msg::Drawer(None)}>Appliquer</Button>
        </Drawer>
    {/if}
    {#if self.toast}
        <Toasts>
            <Toast success title="Enregistré" onclose={Msg::Toast}>Vos modifications sont prises en compte.</Toast>
        </Toasts>
    {/if}
</Page>
