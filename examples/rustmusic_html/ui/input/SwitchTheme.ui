<!-- ui/input/SwitchTheme.svelte, avec les classes Tailwind de la source : le bouton bascule
     l'interrupteur ; le thème clair n'est pas traduit (les jetons de couleur sont résolus à
     la compilation). Les <span> sont des <div> ; la couleur de l'icône (composant) est sur
     un <div> qui l'entoure. -->
<button class="inline-flex items-center rounded-full p-1 transition-colors
               bg-neutral-200 dark:bg-neutral-800"
        onclick={Msg::ToggleTheme} aria-label={if self.dark {"Clair"} else {"Sombre"}}>
    <div class="relative inline-flex h-7 w-12 items-center rounded-full transition-colors
                bg-neutral-300 dark:bg-neutral-700">
        <!-- top-0.5 : position statique d'un enfant absolu d'une rangée items-center (centré
             dans le navigateur), que le moteur laisse en haut (ajout de la traduction). -->
        <div class="absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-white shadow
                    transition-transform
                    top-0.5"
             class:translate-x-6={self.dark} class:translate-x-1={!self.dark}>
            {#if self.dark}
                <div class="text-neutral-800"><Icon icon="tabler:moon" width={16} /></div>
            {:else}
                <div class="text-amber-500"><Icon icon="tabler:sun" width={16} /></div>
            {/if}
        </div>
    </div>
</button>
