<!-- library/common/LibrarySelector.svelte : bouton et liste des bibliothèques de la source
     (fixed, sous le bouton à 6 px, au moins 248 px). Le « … » de gestion de chaque
     bibliothèque (LibraryManageMenu, menu en cascade) ne s'ouvre pas. Repliée : l'icône
     seule (flex-none, p-1.75), et la liste s'ouvre à droite du bouton, haut aligné, 8 px
     plus loin, sur 272 px (left: r.right + 8 ; top: r.top ; width: 272px). Classes
     Tailwind de la source ; <b> et <small> voisins en <div> (voir SidebarRow.ui). Bibliothèque locale : icône
     bg-(--sb-gbg) text-(--sb-g). w-full du bouton seulement dépliée : dans la boîte
     flex-none de largeur auto (repliée), le moteur résout w-full sur toute la rangée au
     lieu de la largeur du contenu. -->
<div class="relative" class:flex-none={self.sidebar_collapsed} class:flex-1={!self.sidebar_collapsed}
     class:min-w-0={!self.sidebar_collapsed}>
    <button id="sidebar.bibliotheque"
            class="flex items-center gap-2.5 rounded-xl cursor-pointer transition-colors
                   bg-(--sb-s1) border border-(--sb-bd) hover:border-(--sb-bd2)"
            class:w-full={!self.sidebar_collapsed} class:p-1.75={self.sidebar_collapsed} class:py-2={!self.sidebar_collapsed}
            class:pr-1.5={!self.sidebar_collapsed} class:pl-2={!self.sidebar_collapsed}
            onclick={Msg::Menu(Menu::Bibliotheque)}
            title="Changer de bibliothèque" aria-label="Changer de bibliothèque"
            aria-haspopup="dialog" aria-expanded={self.open(Menu::Bibliotheque)}>
        <div class="relative w-9 h-9 rounded-[9px] shrink-0 flex items-center justify-center bg-(--sb-gbg) text-(--sb-g)">
            <Icon icon="material-symbols:hard-drive-outline" width={20} epais />
        </div>
        {#if !self.sidebar_collapsed}
            <div class="flex-1 flex flex-col gap-px min-w-0 text-left">
                <div class="text-sm font-bold truncate text-(--sb-tx)">{data::BIBLIOTHEQUES[self.bibliotheque].nom}</div>
                <div class="text-xs truncate text-(--sb-mu)">{format!("{} · 4 biblio.", data::BIBLIOTHEQUES[self.bibliotheque].titres)}</div>
            </div>
            <div class="shrink-0 text-(--sb-tx2)"><Icon icon="material-symbols:unfold-more-rounded" width={18} /></div>
        {/if}
    </button>
</div>

<!-- Liste : div.fixed (position, width) > div.rounded-xl… ; le k-popover porte les deux,
     la largeur de style= en w-[248px] (au moins la largeur du bouton : match-width) ou
     w-[272px] (repliée). p-0 retire le padding par défaut du panneau. -->
{#if self.open(Menu::Bibliotheque) && self.sidebar_collapsed}
    <k-popover id="sidebar.bibliotheque.menu" anchor="sidebar.bibliotheque" placement="right-start" offset="8"
               aria-label="Bibliothèques" onclose={Msg::CloseMenu}
               class="rounded-xl border overflow-hidden bg-white/98 dark:bg-neutral-900/98 backdrop-blur-xl
                      border-neutral-200/60 dark:border-white/8 shadow-xl shadow-black/10 dark:shadow-black/40
                      p-0 w-[272px] menu">
        {@include "LibraryMenu.ui"}
    </k-popover>
{:else if self.open(Menu::Bibliotheque)}
    <k-popover anchor="sidebar.bibliotheque" placement="bottom-start" offset="6" match-width
               aria-label="Bibliothèques" onclose={Msg::CloseMenu}
               class="rounded-xl border overflow-hidden bg-white/98 dark:bg-neutral-900/98 backdrop-blur-xl
                      border-neutral-200/60 dark:border-white/8 shadow-xl shadow-black/10 dark:shadow-black/40
                      p-0 w-[248px] menu">
        {@include "LibraryMenu.ui"}
    </k-popover>
{/if}
