<!-- ui/contextmenu/PlaylistZoneMenu.svelte : options de la zone des playlists, sous le
     bouton « … » (bord droit 16 px au-delà du bouton, 4 px dessous). Les raccourcis
     affichent ou masquent les lignes « Titres likés » et « Récemment joués ». Classes
     Tailwind de la source (constante `ligne` développée) ; <p> en <div> (marge par défaut). Les
     classes d'une <Icon> passent sur sa pastille (même couleur héritée). Ajout de la
     traduction : le focus clavier d'une ligne a le fond de son survol
     (dark:focus-visible:bg-white/5). fixed z-[9999] du panneau : le k-popover le place
     (position: fixed y est refusée à l'exécution). -->
{#if self.open(Menu::Affichage)}
    <k-popover anchor="sidebar.playlists.options" placement="bottom-end" offset="4" cross-offset="16"
               aria-label="Options d'affichage" onclose={Msg::CloseMenu}
               class="w-66 p-1.5
                      bg-white/95 dark:bg-neutral-950/95 backdrop-blur-xl
                      border border-neutral-200/80 dark:border-white/10
                      rounded-2xl overflow-hidden
                      shadow-xl shadow-black/10 dark:shadow-2xl dark:shadow-black/50 menu">
        <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                       hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                onclick={Msg::CloseMenu}>
            <!-- bg-emerald-500/12 border border-emerald-500/25, icône text-emerald-600 dark:text-emerald-400 -->
            <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center
                        bg-emerald-500/12 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400">
                <Icon icon="material-symbols:queue-music-rounded" width={15} />
            </div>
            <span class="flex-1 text-[13px] font-semibold text-neutral-800 dark:text-neutral-100">Toutes les playlists</span>
            <div class="flex text-neutral-300 dark:text-neutral-600 shrink-0"><Icon icon="lucide:chevron-right" width={13} /></div>
        </button>
        <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                       hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                onclick={Msg::CloseMenu}>
            <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center
                        bg-neutral-100 dark:bg-white/5 border border-neutral-200/80 dark:border-white/8
                        text-neutral-500 dark:text-neutral-400">
                <Icon icon="material-symbols:swap-vert-rounded" width={15} />
            </div>
            <span class="flex-1 text-[13px] text-neutral-700 dark:text-neutral-200">Organiser la barre latérale</span>
        </button>

        <div class="h-px mx-2 my-1.5 bg-neutral-200/80 dark:bg-white/8" role="separator"></div>

        <div class="px-2.5 pt-1.5 pb-2 text-[10px] font-semibold uppercase tracking-widest
                    text-neutral-400 dark:text-neutral-500">Raccourcis</div>
        <!-- Pastilles reprises de la barre latérale ({r.pastille}, {r.teinte}) : une branche
             par raccourci (classes avec /). -->
        {#each data::RACCOURCIS as (i, r) (r.0)}
            <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                           hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                    onclick={Msg::BasculerRaccourci(i)}>
                {#if i == 0}
                    <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center border
                                bg-linear-to-br from-rose-500/15 to-pink-500/25 border-rose-500/20
                                transition-opacity text-rose-400"
                         class:opacity-40={!self.raccourcis[i]}>
                        <Icon icon={r.1} width={14} />
                    </div>
                {:else}
                    <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center border
                                bg-linear-to-br from-sky-500/15 to-cyan-500/25 border-sky-500/20
                                transition-opacity text-sky-400"
                         class:opacity-40={!self.raccourcis[i]}>
                        <Icon icon={r.1} width={14} />
                    </div>
                {/if}
                <div class="flex-1 min-w-0 text-[13px] truncate"
                     class:text-neutral-800={self.raccourcis[i]} class:dark:text-neutral-100={self.raccourcis[i]}
                     class:dark:text-neutral-500={!self.raccourcis[i]}>{r.0}</div>
                <div class="w-8 h-4.5 rounded-full shrink-0 relative transition-colors"
                     class:bg-emerald-500={self.raccourcis[i]} class:bg-neutral-300={!self.raccourcis[i]}
                     class:dark:bg-neutral-700={!self.raccourcis[i]}>
                    <div class="absolute top-0.5 left-0.5 w-3.5 h-3.5 rounded-full bg-white shadow-sm transition-transform"
                         class:translate-x-3.5={self.raccourcis[i]}></div>
                </div>
            </button>
        {/each}

        <div class="h-px mx-2 my-1.5 bg-neutral-200/80 dark:bg-white/8" role="separator"></div>

        <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                       hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                onclick={Msg::CloseMenu}>
            <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center
                        bg-neutral-100 dark:bg-white/5 border border-neutral-200/80 dark:border-white/8
                        text-neutral-500 dark:text-neutral-400">
                <Icon icon="lucide:sliders-horizontal" width={13} />
            </div>
            <span class="flex-1 text-[13px] text-neutral-700 dark:text-neutral-200">Réglages d'affichage…</span>
            <div class="flex text-neutral-300 dark:text-neutral-600 shrink-0"><Icon icon="lucide:chevron-right" width={13} /></div>
        </button>
    </k-popover>
{/if}
