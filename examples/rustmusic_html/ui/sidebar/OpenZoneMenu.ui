<!-- ui/contextmenu/OpenZoneMenu.svelte : sous le « … » de la rangée Fichier / Dossier
     (bord droit 16 px au-delà du bouton, 4 px dessous) : sections de la bibliothèque
     (LibraryTabsOptions.svelte), puis la rangée elle-même. Classes Tailwind de la source
     (constantes `titre` et `ligne` développées) ; <p> en <div> (marge par défaut). Les classes d'une
     <Icon> passent sur sa pastille (même couleur héritée). Ajout de la traduction : le
     focus clavier d'une ligne a le fond de son survol (dark:focus-visible:bg-white/5).
     fixed z-[9999] du panneau : le k-popover le place (position: fixed y est refusée à
     l'exécution). -->
{#if self.open(Menu::Ouvrir)}
    <k-popover anchor="sidebar.ouvrir" placement="bottom-end" offset="4" cross-offset="16"
               aria-label="Ouvrir" onclose={Msg::CloseMenu}
               class="w-66 p-1.5
                      bg-white/95 dark:bg-neutral-950/95 backdrop-blur-xl
                      border border-neutral-200/80 dark:border-white/10
                      rounded-2xl overflow-hidden
                      shadow-xl shadow-black/10 dark:shadow-2xl dark:shadow-black/50 menu">
        <!-- LibraryTabsOptions -->
        <div class="px-2.5 pt-1.5 pb-2 text-[10px] font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">Sections de la bibliothèque</div>
        <!-- Trois maquettes : bg-emerald-500/70 allumée, bg-neutral-300 dark:bg-white/10
             sinon ; placement choisi bg-emerald-500/10 border-emerald-500/30, les autres
             border-transparent hover:bg-neutral-100 dark:hover:bg-white/5 (une branche par
             état). text-[10px] leading-none du libellé : le moteur rogne le texte à sa boîte
             de ligne, 10 px couperait l'accent de « À » ; ligne de 14 px reprise par
             -my-0.5 (leading-[14px] -my-0.5 au lieu de leading-none). w-auto : le <div>
             garderait toute la largeur de la colonne malgré items-center. -->
        <div class="flex gap-1 px-1 pb-1">
            {#each data::PLACEMENTS_ONGLETS as (i, p) (p.0)}
                {#if self.placement_onglets as usize == i}
                    <button class="flex-1 flex flex-col items-center gap-1 py-1.5 rounded-lg cursor-pointer
                                   border transition-colors bg-emerald-500/10 border-emerald-500/30"
                            onclick={Msg::PlacementOnglets(i as u8)} title={p.0}>
                        <div class="w-9 h-6 rounded flex gap-0.5 p-0.5 bg-neutral-100 dark:bg-white/5">
                            {#if p.1}<div class="w-1/4 h-full rounded-[2px] bg-emerald-500/70"></div>
                            {:else}<div class="w-1/4 h-full rounded-[2px] bg-neutral-300 dark:bg-white/10"></div>{/if}
                            <div class="flex-1 flex flex-col gap-0.5">
                                {#if p.2}<div class="h-1 rounded-[2px] bg-emerald-500/70"></div>
                                {:else}<div class="h-1 rounded-[2px] bg-neutral-300 dark:bg-white/10"></div>{/if}
                                <div class="flex-1 rounded-[2px] bg-neutral-200 dark:bg-white/4"></div>
                            </div>
                        </div>
                        <span class="text-[10px] leading-[14px] -my-0.5 w-auto text-emerald-600 dark:text-emerald-400">{p.0}</span>
                    </button>
                {:else}
                    <button class="flex-1 flex flex-col items-center gap-1 py-1.5 rounded-lg cursor-pointer
                                   border transition-colors border-transparent hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                            onclick={Msg::PlacementOnglets(i as u8)} title={p.0}>
                        <div class="w-9 h-6 rounded flex gap-0.5 p-0.5 bg-neutral-100 dark:bg-white/5">
                            {#if p.1}<div class="w-1/4 h-full rounded-[2px] bg-emerald-500/70"></div>
                            {:else}<div class="w-1/4 h-full rounded-[2px] bg-neutral-300 dark:bg-white/10"></div>{/if}
                            <div class="flex-1 flex flex-col gap-0.5">
                                {#if p.2}<div class="h-1 rounded-[2px] bg-emerald-500/70"></div>
                                {:else}<div class="h-1 rounded-[2px] bg-neutral-300 dark:bg-white/10"></div>{/if}
                                <div class="flex-1 rounded-[2px] bg-neutral-200 dark:bg-white/4"></div>
                            </div>
                        </div>
                        <span class="text-[10px] leading-[14px] -my-0.5 w-auto text-neutral-500 dark:text-neutral-400">{p.0}</span>
                    </button>
                {/if}
            {/each}
        </div>

        <div class="h-px mx-2 my-1.5 bg-neutral-200/80 dark:bg-white/8" role="separator"></div>

        <div class="px-2.5 pt-1.5 pb-2 text-[10px] font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">Sections affichées</div>
        <!-- Icône : text-neutral-600 dark:text-neutral-300 (affichée) / text-neutral-400. -->
        {#each data::ONGLETS as (i, onglet) (onglet.0)}
            <button class="w-full flex items-center gap-2.5 px-2 py-1.5 rounded-xl cursor-pointer text-left transition-colors
                           hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                    onclick={Msg::BasculerOnglet(i)}>
                <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center border
                            bg-neutral-100 dark:bg-white/5 border-neutral-200/80 dark:border-white/8 transition-opacity"
                     class:opacity-40={!self.onglets[i]} class:text-neutral-600={self.onglets[i]}
                     class:dark:text-neutral-300={self.onglets[i]} class:text-neutral-400={!self.onglets[i]}>
                    <Icon icon={onglet.2} width={13} />
                </div>
                <div class="flex-1 min-w-0 text-[13px] truncate"
                     class:text-neutral-800={self.onglets[i]} class:dark:text-neutral-100={self.onglets[i]}
                     class:text-neutral-400={!self.onglets[i]} class:dark:text-neutral-500={!self.onglets[i]}>{onglet.1}</div>
                <div class="w-8 h-4.5 rounded-full shrink-0 relative transition-colors"
                     class:bg-emerald-500={self.onglets[i]} class:bg-neutral-300={!self.onglets[i]}
                     class:dark:bg-neutral-700={!self.onglets[i]}>
                    <div class="absolute top-0.5 left-0.5 w-3.5 h-3.5 rounded-full bg-white shadow-sm transition-transform"
                         class:translate-x-3.5={self.onglets[i]}></div>
                </div>
            </button>
        {/each}

        <div class="h-px mx-2 my-1.5 bg-neutral-200/80 dark:bg-white/8" role="separator"></div>

        <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                       hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                onclick={Msg::MasquerOuvrir}>
            <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center
                        bg-neutral-100 dark:bg-white/5 border border-neutral-200/80 dark:border-white/8
                        text-neutral-500 dark:text-neutral-400">
                <Icon icon="lucide:eye-off" width={13} />
            </div>
            <span class="flex-1 text-[13px] text-neutral-700 dark:text-neutral-200">Masquer Fichier et Dossier</span>
        </button>
        <!-- Masquée, la section emporte son propre menu : on dit donc où la retrouver avant
             qu'elle ne disparaisse. -->
        <div class="px-2.5 pt-1 pb-2 text-[11px] leading-snug text-neutral-400 dark:text-neutral-500">Ils se réaffichent depuis Réglages → Apparence.</div>

        <div class="h-px mx-2 mb-1.5 bg-neutral-200/80 dark:bg-white/8" role="separator"></div>

        <button class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl cursor-pointer text-left transition-colors
                       hover:bg-neutral-100 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                onclick={Msg::CloseMenu}>
            <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center
                        bg-neutral-100 dark:bg-white/5 border border-neutral-200/80 dark:border-white/8
                        text-neutral-500 dark:text-neutral-400">
                <Icon icon="lucide:sliders-horizontal" width={13} />
            </div>
            <span class="flex-1 text-[13px] text-neutral-700 dark:text-neutral-200">Réglages d'affichage…</span>
            <div class="flex text-neutral-300 dark:text-neutral-600 shrink-0"><Icon icon="lucide:chevron-right" width={13} /></div>
        </button>
    </k-popover>
{/if}
