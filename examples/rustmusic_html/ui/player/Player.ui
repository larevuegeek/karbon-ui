<!-- player/Player.svelte — un fichier local chargé (pas de radio, pas de chapitres,
     pas de lecteur réseau sélectionné). Le menu Sortie et le détail de la chaîne
     (popovers) restent fermés. Classes Tailwind de la source ; lecteur, lecteur-pochette,
     lecteur-lecture et lecteur-dossier sont des classes d'app.css (player.css).
     Les <span>/<button> de texte de la source sont des <div> (voir SidebarRow.ui). -->
<!-- font-mono : app.css le redéfinit dans le lecteur (.lecteur .font-mono { font-family:
     'JetBrains Mono Variable', … }) ; une règle .lecteur .font-mono déclarerait font-mono
     dans la feuille pour toute l'application (la classe de la feuille l'emporte sur
     l'utilitaire) : font-(--font-mono) à sa place. -->
<div class="shrink-0 px-2.5 pt-1.5 pb-2.5">
    <!-- Pas d'overflow-hidden : le menu Sortie et le détail de la chaîne débordent vers le haut. -->
    <div id="player.carte" class="lecteur relative rounded-[18px]">
        <!-- ─── Pochette et titres · commandes et progression · actions ─── -->
        <div class="grid grid-cols-[minmax(220px,1fr)_minmax(300px,1.4fr)_minmax(max-content,1fr)] items-center gap-7 max-[1250px]:gap-5 h-23 pl-2 pr-5
                    max-lg:grid-cols-[minmax(0,1fr)_auto] max-lg:h-auto max-lg:py-3 max-lg:gap-x-3 max-lg:gap-y-2">
            <div class="flex items-center gap-4 min-w-0">
                <div class="relative shrink-0">
                    <div class="lecteur-pochette w-19 h-19 rounded-xl overflow-hidden">
                        <!-- ImgZoom : <button class="cursor-zoom-in"><img class="rounded" width=96>.
                             TODO-TW: cursor-zoom-in — « cursor: zoom-in is not implemented; use auto,
                             default, pointer… » ;
                             le bouton d'agrandissement n'est pas traduit. L'image remplit la
                             boîte (max-width: 100 % de la feuille de base) : w-full h-full
                             object-cover. -->
                        <img class="rounded w-full h-full object-cover" src={cover(data::FICHE.pochette)} alt="">
                    </div>
                    <!-- Pastille de lecture, détourée de la couleur du lecteur. -->
                    {#if self.playing}
                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-[#141816]"></div>
                    {/if}
                </div>
                <div class="min-w-0 flex flex-col gap-0.75 leading-tight">
                    <div class="text-[17px] font-bold tracking-[-0.01em] text-(--lc-tx) min-w-0 truncate text-left cursor-pointer hover:underline underline-offset-3"
                         onclick={Msg::Noop} title={data::FICHE.titre}>{data::FICHE.titre}</div>
                    <div class="flex items-center gap-1 min-w-0 text-sm font-medium text-(--lc-tx2) whitespace-nowrap">
                        <div class="text-(--lc-acc) shrink-0 max-w-[75%] min-w-0 truncate text-left cursor-pointer hover:underline underline-offset-3"
                             onclick={Msg::Noop} title={data::FICHE.artiste}>{data::FICHE.artiste}</div>
                        <div class="shrink-0 text-(--lc-mu)">·</div>
                        <div class="text-(--lc-mu) min-w-0 truncate text-left cursor-pointer hover:underline underline-offset-3"
                             onclick={Msg::Noop} title={data::FICHE.album}>{data::FICHE.album}</div>
                    </div>
                    <!-- w-auto : le paragraphe ne s'étire pas sur la colonne (self-start). -->
                    <div class="self-start text-xs font-medium tabular-nums text-(--lc-mu) cursor-pointer hover:text-(--lc-tx2) hover:underline underline-offset-3 w-auto"
                         onclick={Msg::Noop} title={format!("Les albums de {}", data::FICHE.annee)}>{data::FICHE.annee}</div>
                </div>
            </div>

            <div class="justify-self-center w-full max-w-155 flex flex-col items-center gap-1.5 min-w-0 max-lg:max-w-none max-lg:col-span-2 max-lg:row-start-2">
                <!-- justify-center : la rangée, qui prend la largeur de son contenu dans la
                     colonne items-center, est étirée par le moteur ; son contenu est centré. -->
                <div class="flex items-center gap-1.5 justify-center">
                    <!-- {ib} {actif} : les jetons de actif contiennent ( ) [ ] / : une branche par état.
                         TODO-TW: text-(--lc-acc)! — un utilitaire !important ne passe pas devant la
                         règle d'état hover:text-(--lc-ic-fort) (ordre seulement, docs/tailwind.md) :
                         hover:text-(--lc-acc)! garde la couleur active au survol, comme le navigateur
                         (idem hover:text-[#ff7a88]! du favori aimé). -->
                    {#if self.shuffle}
                        <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)
                                       text-(--lc-acc)! after:absolute after:bottom-0.75 after:left-1/2 after:-ml-[1.5px] after:w-0.75 after:h-0.75 after:rounded-full after:bg-current hover:text-(--lc-acc)!"
                                onclick={Msg::Shuffle} title="Aléatoire" aria-label="Aléatoire">
                            <Icon icon="material-symbols-light:shuffle-rounded" width={22} />
                        </button>
                    {:else}
                        <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                                onclick={Msg::Shuffle} title="Aléatoire" aria-label="Aléatoire">
                            <Icon icon="material-symbols-light:shuffle-rounded" width={22} />
                        </button>
                    {/if}
                    <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol) max-[1250px]:hidden"
                            onclick={Msg::Seek((self.position - 10.).max(0.))} title="Reculer de 10 s" aria-label="Reculer de 10 s">
                        <Icon icon="material-symbols-light:replay-10-rounded" width={22} />
                    </button>
                    <button class="w-11 h-11 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                            onclick={Msg::Noop} title="Précédent" aria-label="Précédent">
                        <Icon icon="material-symbols-light:skip-previous-rounded" width={32} />
                    </button>
                    <button class="lecteur-lecture relative w-12.5 h-12.5 mx-2 shrink-0 flex items-center justify-center rounded-full cursor-pointer
                                   bg-(--lc-play) text-(--lc-play-tx) transition-transform hover:scale-105 active:scale-95"
                            onclick={Msg::Play}
                            title={if self.playing {"Pause (Espace)"} else {"Lecture (Espace)"}}
                            aria-label={if self.playing {"Pause (Espace)"} else {"Lecture (Espace)"}}>
                        <Icon icon={if self.playing {"material-symbols-light:pause-rounded"} else {"material-symbols-light:play-arrow-rounded"}} width={32} />
                    </button>
                    <button class="w-11 h-11 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                            onclick={Msg::Noop} title="Suivant" aria-label="Suivant">
                        <Icon icon="material-symbols-light:skip-next-rounded" width={32} />
                    </button>
                    <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol) max-[1250px]:hidden"
                            onclick={Msg::Seek((self.position + 10.).min(data::FICHE.duree))} title="Avancer de 10 s" aria-label="Avancer de 10 s">
                        <Icon icon="material-symbols-light:forward-10-rounded" width={22} />
                    </button>
                    {#if self.repeat}
                        <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)
                                       text-(--lc-acc)! after:absolute after:bottom-0.75 after:left-1/2 after:-ml-[1.5px] after:w-0.75 after:h-0.75 after:rounded-full after:bg-current hover:text-(--lc-acc)!"
                                onclick={Msg::Repeat} title="Répéter" aria-label="Répéter">
                            <Icon icon="material-symbols-light:repeat-rounded" width={22} />
                        </button>
                    {:else}
                        <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                                onclick={Msg::Repeat} title="Répéter" aria-label="Répéter">
                            <Icon icon="material-symbols-light:repeat-rounded" width={22} />
                        </button>
                    {/if}
                    <!-- disabled={!hasTrack} : un morceau est chargé, le bouton est actif. -->
                    <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol) max-[1080px]:hidden disabled:opacity-40 disabled:cursor-default"
                            onclick={Msg::Seek(0.)} title="Arrêt" aria-label="Arrêt">
                        <Icon icon="material-symbols-light:stop-outline-rounded" width={22} />
                    </button>
                </div>
                <div class="flex items-center gap-3 w-full font-(--font-mono) text-[11px] tabular-nums text-(--lc-mu)">
                    <div class="min-w-9 text-right">{minutes_seconds(self.position)}</div>
                    <div class="flex-1 min-w-0">{@include "PlayerProgressBar.ui"}</div>
                    <div class="min-w-9">{minutes_seconds(data::FICHE.duree)}</div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-0.5 max-lg:col-start-2 max-lg:row-start-1">
                <!-- favori {ib} : favori n'est défini ni par app.css ni par Tailwind (marqueur), omis. -->
                {#if self.liked}
                    <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)
                                   text-[#e2566a]! dark:text-[#ff7a88]! hover:text-[#ff7a88]!"
                            onclick={Msg::Like} title="J'aime" aria-label="J'aime">
                        <Icon icon="material-symbols-light:favorite-rounded" width={22} />
                    </button>
                {:else}
                    <button class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                            onclick={Msg::Like} title="J'aime" aria-label="J'aime">
                        <Icon icon="material-symbols-light:favorite-outline-rounded" width={22} />
                    </button>
                {/if}
                <!-- File d'attente : {ib} seul dans la source (le panneau ouvert ne teinte pas le bouton). -->
                <button id="player.file" class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                        onclick={Msg::Menu(Menu::File)}
                        title="File d'attente" aria-label="File d'attente" aria-expanded={self.open(Menu::File)}>
                    <Icon icon="material-symbols-light:queue-music-rounded" width={22} />
                </button>
                {#if self.open(Menu::Paroles)}
                    <button id="player.paroles" class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)
                                   text-(--lc-acc)! after:absolute after:bottom-0.75 after:left-1/2 after:-ml-[1.5px] after:w-0.75 after:h-0.75 after:rounded-full after:bg-current hover:text-(--lc-acc)!"
                            onclick={Msg::Menu(Menu::Paroles)}
                            title="Paroles" aria-label="Paroles" aria-expanded={self.open(Menu::Paroles)}>
                        <Icon icon="material-symbols-light:lyrics-outline-rounded" width={22} />
                    </button>
                {:else}
                    <button id="player.paroles" class="relative w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
                            onclick={Msg::Menu(Menu::Paroles)}
                            title="Paroles" aria-label="Paroles" aria-expanded={self.open(Menu::Paroles)}>
                        <Icon icon="material-symbols-light:lyrics-outline-rounded" width={22} />
                    </button>
                {/if}
                <div class="w-px h-5.5 mx-2 shrink-0 bg-(--lc-trait) max-md:hidden" aria-hidden="true"></div>
                {@include "PlayerSoundBar.ui"}
            </div>
        </div>

        <!-- ─── Ligne d'état : qualité du son · fichier · chaîne et services ─── -->
        <div class="flex items-center gap-2.5 h-8 pl-3 pr-2 rounded-b-[18px] text-[11px] text-(--lc-mu) border-t border-(--lc-statut-bd) bg-(--lc-statut)">
            <!-- role="group" ; le détail de la chaîne au survol (PipelineInfoPopover) n'est pas traduit. -->
            <div class="shrink-0 flex items-center gap-2 whitespace-nowrap cursor-help" aria-label="Chaîne audio">
                <div class="h-5 px-1.5 flex items-center rounded-[5px] text-[10px] font-bold tracking-[0.06em] bg-(--lc-fmt-bg) text-(--lc-fmt-tx)">{data::STATUT.format}</div>
                <div class="font-(--font-mono) font-medium text-(--lc-tx)">{data::STATUT.qualite}</div>
                {#if !data::STATUT.sortie.is_empty()}
                    <div class="font-(--font-mono) text-amber-600 dark:text-amber-400">{format!("→ {}", data::STATUT.sortie)}</div>
                {/if}
                <div class="font-(--font-mono) max-[1080px]:hidden">{data::STATUT.debit}</div>
            </div>

            <div class="w-px h-3.5 shrink-0 bg-(--lc-trait) max-md:hidden" aria-hidden="true"></div>

            <div class="group/chemin flex-1 min-w-0 overflow-hidden flex items-center gap-1 font-(--font-mono) text-[10.5px] max-md:hidden">
                <!-- Icône : shrink-0 group-hover/chemin:text-(--lc-tx2) ; <Icon> ne prend pas de
                     classe et un conteneur décale son tracé d'un pixel physique : la couleur du
                     survol est posée sur le bouton (le nom du fichier est déjà en --lc-tx2). -->
                <button class="min-w-0 flex items-center gap-1.5 cursor-pointer group-hover/chemin:text-(--lc-tx2)" onclick={Msg::Noop} title="Afficher dans le dossier">
                    <Icon icon="material-symbols-light:folder-open-outline-rounded" width={15} />
                    <div class="lecteur-dossier min-w-0 shrink-[999] truncate group-hover/chemin:text-(--lc-tx2)">{data::STATUT.dossier}</div>
                    <!-- Le dossier s'efface d'abord, le nom se tronque ensuite. -->
                    <div class="min-w-8 truncate text-(--lc-tx2)" title={data::STATUT.fichier}>{data::STATUT.fichier}</div>
                </button>
                <button class="shrink-0 w-5.5 h-5.5 flex items-center justify-center rounded-md cursor-pointer opacity-0 group-hover/chemin:opacity-100 focus-visible:opacity-100 hover:bg-(--lc-survol) hover:text-(--lc-tx)"
                        onclick={Msg::Noop} title="Copier le chemin" aria-label="Copier le chemin">
                    <Icon icon="material-symbols-light:content-copy-outline-rounded" width={14} />
                </button>
                {#if !self.playing}
                    <button class="shrink-0 w-5.5 h-5.5 flex items-center justify-center rounded-md cursor-pointer hover:text-red-500 hover:bg-(--lc-survol)"
                            onclick={Msg::Noop} title="Fermer le morceau" aria-label="Fermer le morceau">
                        <Icon icon="material-symbols-light:close-rounded" width={15} />
                    </button>
                {/if}
            </div>

            <div class="min-w-0 ml-auto flex items-center gap-1.5">
                <!-- {pastille} {TEINTE.bleu} {pastilleCliquable} max-w-44 max-[1250px]:hidden -->
                <button class="shrink-0 h-5.5 px-2 flex items-center gap-1.5 rounded-full whitespace-nowrap text-[10.5px] font-semibold border
                               bg-sky-500/12 border-sky-600/25 text-sky-800 dark:border-sky-400/25 dark:text-sky-300
                               cursor-pointer transition-colors hover:border-current/50 max-w-44 max-[1250px]:hidden"
                        onclick={Msg::Noop} title="Sortie audio">
                    <div class="flex shrink-0"><Icon icon="material-symbols-light:speaker-outline-rounded" width={14} /></div>
                    <div class="truncate">{data::SORTIES[self.sortie].nom}</div>
                </button>
                {@include "NetworkMenu.ui"}
            </div>
        </div>
    </div>
</div>
