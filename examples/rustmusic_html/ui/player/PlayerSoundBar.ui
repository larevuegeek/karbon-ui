<!-- player/PlayerSoundBar.svelte : sortie audio (et son menu), sourdine et volume, avec
     les classes Tailwind de la source. Le <div bind:this={menuEl}> qui entoure le bouton
     de sortie et son menu n'est pas repris (le k-popover se place lui-même). -->
<!-- {bouton} text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol) {showDevices ? 'text-(--lc-acc)' : ''}
     Ouvert : text-(--lc-acc)! garde la couleur de la traduction précédente (.ib.ouvert). -->
{#if self.open(Menu::Sortie)}
    <button id="player.sortie" class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors
                                      text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol) text-(--lc-acc)!"
            onclick={Msg::Menu(Menu::Sortie)}
            title={format!("Sortie audio : {}", data::SORTIES[self.sortie].nom)} aria-label="Sortie audio"
            aria-haspopup="listbox" aria-expanded={self.open(Menu::Sortie)}>
        <Icon icon="material-symbols-light:speaker-outline-rounded" width={22} />
    </button>
{:else}
    <button id="player.sortie" class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors
                                      text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
            onclick={Msg::Menu(Menu::Sortie)}
            title={format!("Sortie audio : {}", data::SORTIES[self.sortie].nom)} aria-label="Sortie audio"
            aria-haspopup="listbox" aria-expanded={self.open(Menu::Sortie)}>
        <Icon icon="material-symbols-light:speaker-outline-rounded" width={22} />
    </button>
{/if}
<!-- {bouton} disabled:cursor-not-allowed disabled:opacity-40 {isMuted ? … : …} (dopActive faux). -->
{#if self.muted}
    <button class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors disabled:cursor-not-allowed disabled:opacity-40
                   text-red-500/85 dark:text-red-400/85 hover:bg-(--lc-survol)"
            onclick={Msg::Mute} aria-label="Rétablir le son" title="Rétablir le son">
        <Icon icon="material-symbols-light:no-sound-outline-rounded" width={28} />
    </button>
{:else}
    <button class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition-colors disabled:cursor-not-allowed disabled:opacity-40
                   text-(--lc-ic) hover:text-(--lc-ic-fort) hover:bg-(--lc-survol)"
            onclick={Msg::Mute} aria-label="Couper le son" title="Couper le son">
        <Icon icon={if self.volume < 50. {"material-symbols-light:volume-down-outline-rounded"} else {"material-symbols-light:volume-up-outline-rounded"}} width={28} />
    </button>
{/if}
<!-- Volume : rail épais, couleur du morceau ; la pastille reste dans le rail, même à 0.
     style:width / style:left de la source (calc() de la valeur) : la valeur passe par la
     variable --volume, lue par w-[calc(…)] et left-[calc(…)]. -->
<div class="group/vol relative w-30 max-[1250px]:w-22 h-5 ml-1.5 shrink-0 flex items-center max-md:hidden"
     style:--volume={volume} title={format!("{} %", self.volume.round())}>
    <div class="relative w-full h-1.25 group-hover/vol:h-1.5 rounded-full bg-(--lc-rail) transition-[height] duration-150">
        {#if self.muted}
            <div class="absolute inset-y-0 left-0 rounded-full bg-red-500/60 w-[calc((100%-12px)*var(--volume,0.8)+6px)]"></div>
        {:else}
            <div class="absolute inset-y-0 left-0 rounded-full bg-(--lc-acc) w-[calc((100%-12px)*var(--volume,0.8)+6px)]"></div>
        {/if}
    </div>
    <!-- Dans le rail en Svelte ; le moteur rogne un enfant positionné à la boîte de son
         hôte (rail de 5 px) : la pastille est posée sur la zone de 20 px (même top-1/2). -->
    <div class="absolute top-1/2 w-3 h-3 -mt-1.5 rounded-full bg-white shadow-[0_1px_4px_rgba(0,0,0,0.45)] pointer-events-none
                transition-transform group-hover/vol:scale-115 left-[calc((100%-12px)*var(--volume,0.8))]"></div>
    <input id="player.volume" class="absolute inset-0 w-full h-full cursor-pointer opacity-0" type="range" min="0" max="100" step="1"
           value={self.volume} oninput={Msg::Volume} aria-label="Volume">
</div>

<!-- Menu des sorties : absolute bottom-full right-2 mb-2 z-50 de la carte du lecteur (placement
     du k-popover, sans ces classes) ; menu (fondu d'entrée) et lecteur-menu (police de la
     carte, player.css) sont des classes de la feuille. Lecteurs réseau activés (deux AirPlay
     trouvés), réglages exclusif et DoP. -->
{#if self.open(Menu::Sortie)}
    <k-popover anchor="player.carte" placement="top-end" offset="8" cross-offset="-8"
               aria-label="Sortie audio" onclose={Msg::CloseMenu}
               class="menu lecteur-menu w-100 p-1.5 rounded-[14px] border
                      bg-(--lc-menu) border-(--lc-menu-bd) shadow-[0_18px_40px_rgba(0,0,0,0.35)] text-(--lc-tx)">
        <div class="px-2.5 pt-1.5 pb-2 text-[11px] font-bold uppercase tracking-[0.08em] text-(--lc-mu)">Sortie audio</div>
        {#each data::SORTIES as (i, s) (s.nom)}
            <!-- Sortie choisie : le vert des réglages, quelle que soit la pochette. -->
            {#if i == self.sortie}
                <div class="relative flex items-stretch rounded-[10px] transition-colors bg-(--rg-g)/12">
                    <div class="absolute left-0 top-2.5 bottom-2.5 w-0.75 rounded-r-[3px] bg-(--rg-g)"></div>
                    {@include "SortieLigne.ui"}
                </div>
            {:else}
                <div class="relative flex items-stretch rounded-[10px] transition-colors hover:bg-(--lc-survol)">
                    {@include "SortieLigne.ui"}
                </div>
            {/if}
        {/each}

        <!-- Lecteurs réseau : la recherche part à la première ouverture. -->
        <div class="mt-1 pt-1 border-t border-(--lc-menu-bd)">
            <div class="flex items-center gap-2 px-2.5 pt-1.5 pb-1.5">
                <!-- Le badge hérite de l'espacement tracking-[0.08em] du titre, comme dans la source. -->
                <div class="flex-1 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-(--lc-mu)">
                    <div class="w-auto">Lecteurs réseau</div>
                    <div class="shrink-0 inline-flex items-center px-1.75 py-0.5 rounded-[5px] border text-[11px] font-bold leading-[1.2] whitespace-nowrap
                                bg-(--rg-ambg) text-(--rg-am) border-(--rg-ambd)">BÊTA</div>
                </div>
                <button class="h-6.5 px-2 flex items-center gap-1 rounded-md text-[11px] font-semibold cursor-pointer text-(--lc-mu) hover:text-(--lc-tx) hover:bg-(--lc-survol) disabled:cursor-default disabled:opacity-60"
                        onclick={Msg::Noop}>
                    <Icon icon="material-symbols-light:refresh-rounded" width={15} />
                    <div class="w-auto">Rechercher</div>
                </button>
            </div>
            {#each data::LECTEURS_RESEAU as r (r.0)}
                <div class="relative flex items-stretch rounded-[10px] transition-colors hover:bg-(--lc-survol)">
                    <button class="flex-1 min-w-0 flex items-center gap-2.5 px-2.5 py-2 text-left cursor-pointer" onclick={Msg::CloseMenu}>
                        <div class="flex shrink-0 text-(--lc-mu)"><Icon icon="material-symbols-light:airplay-rounded" width={20} /></div>
                        <div class="min-w-0 flex-1 leading-[1.2]">
                            <div class="block truncate text-[13px] font-semibold">{r.0}</div>
                            <div class="block truncate text-[11px] text-(--lc-mu)">{r.1}</div>
                        </div>
                        <!-- TODO-TW: invisible — « CSS property 'visibility' is not implemented; it has
                             not been ignored » : opacity-0. -->
                        <div class="flex shrink-0 text-(--rg-g) opacity-0"><Icon icon="material-symbols-light:check-rounded" width={20} /></div>
                    </button>
                </div>
            {/each}
        </div>

        <div class="mt-1 pt-1 border-t border-(--lc-menu-bd)">
            <div class="flex items-center gap-2.5 px-2.5 py-2">
                <div class="min-w-0 flex-1 leading-[1.2]">
                    <div class="block text-[13px] font-semibold">Exclusif · bit-perfect</div>
                    <div class="block text-[11px] text-(--lc-mu)">{if self.exclusif {"Bit-perfect · mixer Windows contourné"} else {"Sortie via le mixer Windows"}}</div>
                </div>
                <!-- ToggleSwitch size="sm" : une branche par état (bg-(--rg-g) / bg-(--rg-off)). -->
                {#if self.exclusif}
                    <button class="relative w-8.5 h-5 rounded-full cursor-pointer transition-colors duration-150 shrink-0
                                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--rg-g)
                                   bg-(--rg-g) disabled:opacity-35 disabled:cursor-not-allowed"
                            onclick={Msg::BasculerExclusif} aria-label="Exclusif · bit-perfect">
                        <div class="absolute top-0.75 left-0.75 rounded-full bg-white shadow-[0_1px_3px_rgba(0,0,0,0.4)] transition-transform duration-150 w-3.5 h-3.5 translate-x-3.5"></div>
                    </button>
                {:else}
                    <button class="relative w-8.5 h-5 rounded-full cursor-pointer transition-colors duration-150 shrink-0
                                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--rg-g)
                                   bg-(--rg-off) disabled:opacity-35 disabled:cursor-not-allowed"
                            onclick={Msg::BasculerExclusif} aria-label="Exclusif · bit-perfect">
                        <div class="absolute top-0.75 left-0.75 rounded-full bg-white shadow-[0_1px_3px_rgba(0,0,0,0.4)] transition-transform duration-150 w-3.5 h-3.5"></div>
                    </button>
                {/if}
            </div>
            <!-- DoP : demande le mode exclusif (texte estompé, interrupteur désactivé sans lui :
                 disabled n'existe pas sur un bouton à contenu, class:opacity-35 à sa place). -->
            <div class="flex items-center gap-2.5 px-2.5 py-2">
                <div class="min-w-0 flex-1 leading-[1.2]" class:opacity-60={!self.exclusif}>
                    <div class="block text-[13px] font-semibold">DSD natif (DoP)</div>
                    <div class="block text-[11px] text-(--lc-mu)">{if !self.exclusif {"Demande le mode exclusif."} else if self.dop {"DSD envoyé tel quel au DAC"} else {"DSD converti en PCM"}}</div>
                </div>
                {#if self.dop}
                    <button class="relative w-8.5 h-5 rounded-full cursor-pointer transition-colors duration-150 shrink-0
                                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--rg-g)
                                   bg-(--rg-g) disabled:opacity-35 disabled:cursor-not-allowed"
                            class:opacity-35={!self.exclusif}
                            onclick={if self.exclusif {Msg::BasculerDop} else {Msg::Noop}} aria-label="DSD natif (DoP)">
                        <div class="absolute top-0.75 left-0.75 rounded-full bg-white shadow-[0_1px_3px_rgba(0,0,0,0.4)] transition-transform duration-150 w-3.5 h-3.5 translate-x-3.5"></div>
                    </button>
                {:else}
                    <button class="relative w-8.5 h-5 rounded-full cursor-pointer transition-colors duration-150 shrink-0
                                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--rg-g)
                                   bg-(--rg-off) disabled:opacity-35 disabled:cursor-not-allowed"
                            class:opacity-35={!self.exclusif}
                            onclick={if self.exclusif {Msg::BasculerDop} else {Msg::Noop}} aria-label="DSD natif (DoP)">
                        <div class="absolute top-0.75 left-0.75 rounded-full bg-white shadow-[0_1px_3px_rgba(0,0,0,0.4)] transition-transform duration-150 w-3.5 h-3.5"></div>
                    </button>
                {/if}
            </div>
        </div>
    </k-popover>
{/if}
