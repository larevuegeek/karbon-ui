<!-- home/HomeRecentlyAdded.svelte — les six albums ajoutés en dernier. Classes Tailwind
     de la source ; <span> en <div>. Le zoom de CoverImg (group-hover:scale-105) passe à
     un conteneur : une image ne se transforme pas.
     Écart : tête items-start, lien mt-[9.5px], au lieu de items-baseline : la ligne de base
     des éléments flex est approchée par le moteur (8,4 px au lieu de 9,5 entre le titre
     24/32 et le lien 14/20). -->
<section class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Ajoutés récemment</h2>
        <button class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer mt-[9.5px]"
                onclick={Msg::Noop}><div>Tout voir</div></button>
    </div>

    <div class="grid grid-cols-3 @3xl:grid-cols-4 @4xl:grid-cols-6 gap-[18px]">
        {#each data::RECENTLY_ADDED as album (album.id)}
            <button class="group w-full min-w-0 overflow-hidden flex flex-col gap-2 text-left cursor-pointer"
                    onclick={Msg::Noop} title={album.titre}>
                <div class="aspect-square rounded-[10px] overflow-hidden bg-neutral-200 dark:bg-neutral-800
                            border border-neutral-200 dark:border-[#1f2522]">
                    <div class="w-full h-full transition-transform duration-300 group-hover:scale-105">
                        <img class="w-full h-full object-cover" src={cover(album.pochette)} alt={album.titre}>
                    </div>
                </div>
                <div class="block text-[15px] font-semibold truncate text-neutral-900 dark:text-neutral-100">{album.titre}</div>
                <div class="block text-[13px] -mt-1.5 truncate text-neutral-500 dark:text-[#9aa39e]">{format!("{} · {}", album.artiste, album.annee)}</div>
            </button>
        {/each}
    </div>
</section>
