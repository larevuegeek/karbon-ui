<!-- home/HomeGenres.svelte — les six genres les plus fournis. Classes Tailwind de la
     source ; genre-tuile, genre-icone, genre-titre et genre-compte sont des classes
     d'app.css (styles/home.css). Fond de la tuile teinté par --h : calculé en Rust
     (genre_tile), un dégradé ne lit pas encore les variables à l'exécution.
     L'<Icon> (88 × 88) est dans un conteneur qui porte ses classes et sa taille (w-22 h-22).
     Écart : tête items-start, lien mt-[9.5px], au lieu de items-baseline : la ligne de base
     des éléments flex est approchée par le moteur (8,4 px au lieu de 9,5 entre le titre
     24/32 et le lien 14/20). -->
<section class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Explorer par genre</h2>
        <button class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer mt-[9.5px]"
                onclick={Msg::Noop}><div>Tous les genres</div></button>
    </div>

    <div class="grid grid-cols-2 @xl:grid-cols-3 @6xl:grid-cols-6 gap-3.5">
        {#each data::GENRES as g (g.name)}
            <button class="genre-tuile group relative w-full min-w-0 h-33 flex items-start rounded-2xl overflow-hidden text-left cursor-pointer
                           transition-transform duration-300 hover:-translate-y-1"
                    onclick={Msg::Noop} style:--h={hue(g.name)} style:background_layers={genre_tile(hue(g.name))}>
                <!-- L'icône du genre, baignée dans la lueur du coin -->
                <div class="genre-icone absolute right-2 -bottom-2 -rotate-12
                            transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-110 w-22 h-22" aria-hidden="true">
                    <Icon icon={g.icone} width={88} />
                </div>

                <div class="relative flex flex-col gap-1 p-4 pr-16">
                    <div class="genre-titre text-[19px] font-extrabold tracking-[-0.01em] leading-tight line-clamp-2">{g.name}</div>
                    <div class="genre-compte text-[12.5px] font-semibold">{format!("{} titres", g.total)}</div>
                </div>
            </button>
        {/each}
    </div>
</section>
